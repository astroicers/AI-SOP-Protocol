{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/.asp/hooks/clean-allow-list.sh\"" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/.asp/hooks/session-audit.sh\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/.asp/hooks/pretooluse-ship-gate.sh\"" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/.asp/hooks/pretooluse-git-guardrails.sh\"" }
        ]
      }
    ]
  }
}
